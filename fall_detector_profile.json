{
  "name": "Fall Detector Profile",
  "type": "FALL_DETECTOR",
  "transportType": "DEFAULT",
  "provisionType": "DISABLED",
  "description": "跌倒检测传感器设备配置文件",
  "profileData": {
    "configuration": {
      "type": "DEFAULT"
    },
    "transportConfiguration": {
      "type": "DEFAULT"
    },
    "alarms": [
      {
        "alarmType": "FALL_DETECTED",
        "createRules": {
          "CRITICAL": {
            "condition": {
              "condition": [
                {
                  "key": {
                    "type": "TIME_SERIES",
                    "key": "fallDetected"
                  },
                  "valueType": "NUMERIC",
                  "value": 1,
                  "predicate": {
                    "operation": "EQUAL"
                  }
                }
              ]
            },
            "alarmDetails": "跌倒检测触发，冲击力: ${fallImpact}G，持续时间: ${fallDuration}s"
          }
        },
        "clearRule": {
          "condition": {
            "condition": [
              {
                "key": {
                  "type": "TIME_SERIES",
                  "key": "fallDetected"
                },
                "valueType": "NUMERIC",
                "value": 0,
                "predicate": {
                  "operation": "EQUAL"
                }
              }
            ]
          },
          "alarmDetails": "跌倒状态已清除"
        },
        "propagate": true,
        "propagateToOwner": true,
        "propagateToTenant": true
      },
      {
        "alarmType": "RESIDENT_STILL",
        "createRules": {
          "CRITICAL": {
            "condition": {
              "condition": [
                {
                  "key": {
                    "type": "TIME_SERIES",
                    "key": "stillAfterFallTime"
                  },
                  "valueType": "NUMERIC",
                  "value": 300,
                  "predicate": {
                    "operation": "GREATER_OR_EQUAL"
                  }
                }
              ]
            },
            "alarmDetails": "跌倒后驻留 ${stillAfterFallTime} 秒，可能意识丧失"
          }
        },
        "clearRule": {
          "condition": {
            "condition": [
              {
                "key": {
                  "type": "TIME_SERIES",
                  "key": "residentStatus"
                },
                "valueType": "STRING",
                "value": "0",
                "predicate": {
                  "operation": "EQUAL"
                }
              }
            ]
          }
        }
      },
      {
        "alarmType": "HEART_RATE_HIGH",
